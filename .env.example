# Drizzle -> Supabase transaction pooler (IPv4 shared)
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres"

# Supabase (Auth / Realtime)
NEXT_PUBLIC_SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Server-only secret - NEVER expose to the client
SUPABASE_SECRET_KEY="sb_secret_..."

# Server-only - HMAC key for public-viewer unlock cookies (any long random string)
ACCESS_TOKEN_SECRET="replace-with-long-random-string"

# Optional: 인증 메일 링크 베이스 URL 폴백 (요청 Origin 헤더가 우선).
# 예: https://app.example.com — 로컬은 http://localhost:3000
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# AI 시안 생성. 서버 전용 시크릿 — 클라이언트에 노출 금지.
# 제공사 선택: openai | anthropic (기본 openai). 전환 시 이 값만 바꾸면 된다.
AI_PROVIDER="openai"

# OpenAI (AI_PROVIDER=openai 일 때 사용)
OPENAI_API_KEY="sk-..."
# 사용할 OpenAI 모델(기본 gpt-5.5, 비전 지원). 비우면 코드 기본값 사용.
OPENAI_MODEL="gpt-5.5"

# Anthropic (AI_PROVIDER=anthropic 일 때 사용)
ANTHROPIC_API_KEY="sk-ant-..."
# 사용할 Anthropic 모델(기본 claude-sonnet-4-6, 비전 지원). 비우면 코드 기본값 사용.
ANTHROPIC_MODEL="claude-sonnet-4-6"

# === AI 생성 속도 튜닝(선택) — 비우면 코드 기본값(60초 이내 목표의 균형 설정) ===
# 참고 이미지 최대 장수. 적을수록 빠름(품질 트레이드오프). 두 provider 공통. 기본 6.
AI_MAX_REFERENCE_IMAGES="6"
# 출력 토큰 상한. 두 provider 공통. 기본 16000.
AI_MAX_OUTPUT_TOKENS="16000"
# OpenAI 추론 강도: off|minimal|low|medium|high|xhigh. 낮을수록 빠름. "off"는 파라미터 생략. 기본 low.
AI_REASONING_EFFORT="low"
# OpenAI 이미지 인식 해상도: low|high|auto. low면 prefill↓·속도↑. 기본 low.
AI_IMAGE_DETAIL="low"

# === 시안 사전 분석 / 하이브리드 생성(선택) ===
# 분석 모델(비전 필수). 비우면 AI_PROVIDER 기본 모델 사용. 예: claude-sonnet-4-6, gpt-5.5
AI_ANALYSIS_MODEL=""
# 분석 출력 토큰 상한. 기본 4000.
AI_ANALYSIS_MAX_OUTPUT_TOKENS="4000"
# 하이브리드 생성 시 첨부할 대표 이미지 장수(분석 패턴이 있을 때). 기본 2.
AI_HYBRID_REFERENCE_IMAGES="2"

# 분석 백필 결과 알림용 Discord Webhook. 비우면 알림을 건너뛴다.
DISCORD_WEBHOOK_URL=""

# (선택) 공개 디자인 패턴 저장 API(POST /api/public/design-patterns/designs) 쓰기 보호 토큰.
# 설정하면 저장 시 헤더 x-design-token 일치를 요구, 비우면 무인증 공개(조회 GET은 항상 무인증).
DESIGN_WRITE_TOKEN=""
